# ============================================================
#  TeaShare 环境变量示例
# ------------------------------------------------------------
#  用法：
#    1. 复制本文件为 .env（与 pom.xml 同级，即项目根目录）
#         cp env.example .env
#    2. 把下面的占位值替换成你自己的真实配置
#    3. .env 已被 .gitignore 排除，不会被提交
#
#  注意：application.yml 通过 spring.config.import: optional:file:./.env[.properties]
#        读取本文件，因此必须以「项目根目录」为工作目录启动应用。
# ============================================================

# ---------------------- MySQL ----------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=tea
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password

# ---------------------- Redis ----------------------
# 注意：向量检索依赖 RediSearch（FT.* 命令），必须使用 redis/redis-stack-server 镜像
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------- RabbitMQ ----------------------
# 注意：社区行为加权用到 x-delayed-message 延迟插件，需使用已安装该插件的镜像
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ---------------------- 大模型 / 向量 / 重排 ----------------------
# OpenAI 兼容模式入口，例如阿里云百炼 MaaS：
#   https://<your-endpoint>.cn-beijing.maas.aliyuncs.com/compatible-mode
OPENAI_BASE_URL=https://your-maas-endpoint/compatible-mode
OPENAI_API_KEY=sk-your-api-key
# 对话模型
OPENAI_MODEL=deepseek-v4.1-flash
# 向量模型（维度需与 RedisVectorStore 索引一致，当前 1024）
OPENAI_EMBEDDING_MODEL=qwen3.7-text-embedding

# ---------------------- 重排（RAG / 推荐） ----------------------
AI_RERANK_MODEL=qwen3.7-text-rerank
AI_RERANK_PATH=/api/v1/services/rerank/text-rerank/text-rerank

# ---------------------- JWT ----------------------
JWT_SECRET=please-change-this-to-a-random-secret-at-least-32-chars
JWT_EXPIRE=86400000

# ---------------------- 阿里云 OSS ----------------------
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET_NAME=your-bucket-name
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# ---------------------- 快递查询 MCP ----------------------
MCP_EXPRESS_API_KEY=sk-your-dashscope-api-key

# ---------------------- Session Cookie ----------------------
# 验证码接口基于 HttpSession，需要浏览器携带 Cookie。
#   生产（HTTPS，推荐经 Nginx 同域反代）：true —— Cookie 打 Secure 标记，仅加密信道传输
#   本地（http:// 直连后端调试）：false —— 否则浏览器拒收 Cookie，验证码验证会失败
# 不设置时默认为 true。
SESSION_COOKIE_SECURE=true

# ---------------------- AI 记忆 ----------------------
# 短期记忆窗口大小
AI_MEMORY_MAX_MESSAGES=20
# 从 sys_history 单次读取的消息条数（建议 >= max-messages）
AI_MEMORY_WINDOW_SIZE=20
# 长期记忆语义召回条数
AI_LTM_TOP_K=5

# ---------------------- RAG 检索参数 ----------------------
# 向量召回条数
AI_RAG_VECTOR_TOP_K=5
# 向量相似度阈值
AI_RAG_SIMILARITY_THRESHOLD=0.5
# BM25（MySQL 全文索引）召回条数
AI_RAG_BM25_TOP_K=5
# RRF 融合后候选条数
AI_RAG_HYBRID_TOP_K=5
# RRF 平滑参数
AI_RAG_RRF_K=60
# 是否开启重排（重排失败会自动降级为召回顺序）
AI_RAG_RERANK_ENABLED=true
# 重排后送入上下文的条数
AI_RAG_RERANK_TOP_N=3